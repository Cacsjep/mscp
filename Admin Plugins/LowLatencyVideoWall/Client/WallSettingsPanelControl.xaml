<UserControl x:Class="LowLatencyVideoWall.Client.WallSettingsPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="620">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="Pane appearance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <Border BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <CheckBox x:Name="titleBarCheck" Content="Show the camera title bar" FontSize="13" Margin="0,0,0,6"/>
                    <TextBlock Text="A strip across the top of every pane with the camera name, like the one the Smart Client draws on its own view items."
                               TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="24,0,0,14"/>

                    <TextBlock Text="Scaling" FontSize="13" Margin="0,0,0,6"/>
                    <RadioButton x:Name="aspectRadio" GroupName="scaling" FontSize="13" Margin="24,0,0,4"
                                 Content="Keep the aspect ratio"/>
                    <RadioButton x:Name="fillRadio" GroupName="scaling" FontSize="13" Margin="24,0,0,6"
                                 Content="Fill the pane"/>
                    <TextBlock Text="Keeping the aspect ratio leaves black bars where the camera's shape does not match the pane's. Filling the pane uses every pixel but distorts the picture."
                               TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="24,0,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Wall" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <Border BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <CheckBox x:Name="viewSelectionCheck" Content="Show the view selection" FontSize="13" Margin="0,0,0,6"/>
                    <TextBlock Text="The row above the wall that lets an operator switch view. Turn it off on an unattended wall that is driven only by rules, and the wall fills the whole workspace."
                               TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="24,0,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Diagnostics" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <Border BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="15">
                <StackPanel>
                    <CheckBox x:Name="diagnosticsCheck" Content="Show the diagnostics overlay" FontSize="13" Margin="0,0,0,6"/>
                    <TextBlock Text="Prints frame rate, codec, resolution, hardware acceleration and timing in the corner of every pane. Useful when commissioning a wall, noise once it runs."
                               TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="24,0,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
